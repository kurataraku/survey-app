# 環境変数のテンプレート
# このファイルをコピーして .env.local を作成し、実際の値を設定してください

# ============================================
# 必須環境変数（Supabase）
# ============================================
# Supabaseのダッシュボード（Settings → API）から取得してください
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# オプション環境変数（メール機能）
# ============================================
# お問い合わせフォームやパスワードリセット機能を使用する場合に設定
EMAIL_SERVICE=resend
# EMAIL_API_KEY=        # Resend APIキー
# EMAIL_FROM=           # 送信元アドレス（例: noreply@careeressence.co.jp）
# NEXT_PUBLIC_SITE_URL= # サイトURL（例: https://careeressence.jp）

# ============================================
# オプション（計測・SEO）
# ============================================
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
# Google Search Console の HTMLタグ方式と併用可
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# IndexNow（未設定時は no-op）
# INDEXNOW_KEY=
# INDEXNOW_HOST=careeressence.jp
# INDEXNOW_KEY_LOCATION=https://careeressence.jp/xxxxxxxx.txt

# SEO自走システム（初期は実行停止を推奨）
# CRON_SECRET=
# SEO_LOOP_ENABLED=false
# SEO_LOOP_EXECUTION_ENABLED=false
# SEO_LOOP_MAX_DAILY_PROPOSALS=10
# SEO_LOOP_MAX_DAILY_EXECUTIONS=3
# SEO_LOOP_MAX_TARGETS_PER_PROPOSAL=3
# SEO_LOOP_LOCK_TTL_SECONDS=240
# SEO_LOOP_GSC_DAYS=28
# SEO_LOOP_GSC_ROW_LIMIT=50
# SEO_LOOP_LLM_MODEL=gpt-4o-mini

# Google Search Console API（readonly）
# GSC_SITE_URL=sc-domain:careeressence.jp
# GSC_SERVICE_ACCOUNT_KEY_PATH=./secrets/gsc-sa.json
# Vercel等ではJSON文字列をSecretとして設定する場合のみ使用
# GSC_SERVICE_ACCOUNT_KEY_JSON=

# Slack承認
# SLACK_BOT_TOKEN=
# SLACK_SEO_CHANNEL_ID=
# SLACK_SIGNING_SECRET=

# ============================================
# オプション環境変数（キャンペーン機能）
# ============================================
# QUOカードPay法人APIを使用する場合に設定
# QUOCARD_API_KEY=      # QUOカードPay 法人API キー
# QUOCARD_API_URL=      # QUOカードPay API エンドポイント

# ============================================
# オプション環境変数（AI要約機能）
# ============================================
# 学校のAI要約生成機能を使用する場合に設定
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
