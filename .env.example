# 環境変数のテンプレート
# このファイルをコピーして .env.local を作成し、実際の値を設定してください

# ============================================
# 必須環境変数（Supabase）
# ============================================
# Supabaseのダッシュボード（Settings → API）から取得してください
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# オプション環境変数（メール機能）
# ============================================
# お問い合わせフォームやパスワードリセット機能を使用する場合に設定
# EMAIL_SERVICE=resend
# EMAIL_API_KEY=
# EMAIL_FROM=
# NEXT_PUBLIC_SITE_URL=

# ============================================
# オプション環境変数（AI要約機能）
# ============================================
# 学校のAI要約生成機能を使用する場合に設定
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
